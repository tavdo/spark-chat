# PostgreSQL
DATABASE_URL="postgresql://spark:spark@localhost:5432/spark?schema=public"

# Auth — use a long random string in production
JWT_SECRET="change-me-to-a-long-random-secret"

# Seeded admin account (prisma db seed)
ADMIN_EMAIL="admin@spark.local"
ADMIN_PASSWORD="changeme-admin"

# Optional: approve new signups without admin (local demo only)
DEV_AUTO_APPROVE="false"

# Optional: Giphy search (https://developers.giphy.com/)
GIPHY_API_KEY=""

# Optional: S3-compatible storage (leave empty to use local ./uploads)
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="auto"

# Chat history retention (hours). Open reports keep their snapshots.
MESSAGE_RETENTION_HOURS="48"

PORT="3000"
